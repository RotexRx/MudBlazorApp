@page "/order/confirmation/{orderId}"

	<MudPaper Class="pa-6 mx-auto mt-5" Style="max-width: 900px;" Elevation="4">
		<MudContainer Class="mt-3" MaxWidth="MaxWidth.Medium">
@if (isProcessing)
{
	<div class="position-absolute w-75 h-75 d-flex flex-column align-items-center justify-content-center">
		<img src="images/loading.gif" alt="loading" />
	</div>
}
else
{

			<div class="text-white mt-5">

				<MudAlert ContentAlignment="HorizontalAlignment.Right" Severity="Severity.Success"   Elevation="4" Dense="true" Variant="Variant.Filled" Class="text-white">
					سفارش شما ثبت شد ، لطفا شماره سفارش را یادداشت کنید 
					<strong> شماره سفارش : @orderId</strong>
				</MudAlert>
			</div>
		
	
}
	</MudContainer>
</MudPaper>

@code {
	private bool isProcessing = false;

	[Parameter]
	public string? orderId { get; set; }

	protected override async Task OnInitializedAsync()
	{
		isProcessing = false;
	}
}
