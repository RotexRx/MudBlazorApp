@page "/category"
@inject ICategoryRepository categoryRepository
@inject NavigationManager NavigationManager
@inject SweetAlertService AlertService
@inject IJSRuntime JS
<MudPaper Class="pa-6 mx-auto mt-5" Style="max-width: 1200px;" Elevation="4">
		<MudContainer Class="mt-3" MaxWidth="MaxWidth.Medium">
@if (isLoading)
{
    <div class="position-absolute w-75 h-75 d-flex flex-column align-items-center justify-content-center">
        <img src="images/loading.gif" alt="loading" />
    </div>
}
else
{

    

    <MudContainer Class="mt-5">

        <MudStack Direction="Row" Justify="Justify.FlexStart" Class="pb-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => NavigationManager.NavigateTo("/category/create"))">
                ساخت دسته بندی جدید
            </MudButton>
        </MudStack>

        <MudPaper Class="shadow border-0 mt-4" Elevation="2">
            <MudPaper Class="bg-dark p-4">
                

                @if (categories?.Any() == true)
                {

                    <MudTable Items="categories">
              
                        <HeaderContent>
                            <MudTh Style="text-align:center">#</MudTh>
                            <MudTh Style="text-align:center">نام</MudTh>
                            <MudTh Style="text-align:center">عمل ها</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="text-align:center" DataLabel="ID">@context.Id</MudTd>
                            <MudTd Style="text-align:center" DataLabel="Name">@context.Name</MudTd>
                            <MudTd Style="text-align:center" DataLabel="Actions">
                                <MudButton Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => HandleRemoveCategory(context.Id))" Class="mr-2">
                                    حذف
                                </MudButton>
                                <MudButton Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => NavigationManager.NavigateTo($"category/edit/{context.Id}"))">
                                    ویرایش
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                        
                    </MudTable>

                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                        No Categories Found
                    </MudAlert>
                }
            </MudPaper>
        </MudPaper>
    </MudContainer>
   
}
    </MudContainer>
</MudPaper>



@code {
    private CategoryInputModel CategoryModel { get; set; } = new();
    private bool isLoading { get; set; } = true;
    private IEnumerable<Category>? categories;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCategories();
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRemoveCategory(int id)
    {
        var category = await categoryRepository.Get(id);
        if (category != null)
        {
            await categoryRepository.Delete(id);
            await LoadCategories();
            await AlertService.ShowSuccess("Success", "Category deleted successfully!");
        }
    }

    private async Task LoadCategories()
    {
        await Task.Delay(1);
        categories = await categoryRepository.GetAll();
    }
}
