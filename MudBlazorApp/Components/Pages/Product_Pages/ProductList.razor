@page "/products"
@inject IProductRepository prodRepo
@inject NavigationManager NavigationManager
@inject SweetAlertService AlertService
@inject IJSRuntime JS



    <MudPaper Class="pa-6 mx-auto mt-5" Style="max-width: 1200px;" Elevation="4">
    <MudContainer Class="mt-3" MaxWidth="MaxWidth.Medium">


        @if (isLoading)
        {
            <div class="position-absolute w-75 h-75 d-flex flex-column align-items-center justify-content-center">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            </div>
        }
        else
        {
          

                <MudStack Direction="Row" Justify="Justify.FlexStart" Class="mb-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => NavigationManager.NavigateTo("/products/create"))">
                        ساخت محصول جدید
                    </MudButton>
                </MudStack>

                <MudPaper Class="shadow border-0 mt-4" Elevation="2">
                    <MudPaper Class="bg-dark p-4">


                        @if (products?.Any() == true)
                        {

                            <MudTable Items="products">

                                <HeaderContent>
                                    <MudTh>#</MudTh>
                                    <MudTh>نام محصول</MudTh>
                                    <MudTh>قیمت</MudTh>
                                    <MudTh>توضیحات</MudTh>
                                    <MudTh>تگ</MudTh>
                                    <MudTh>عکس</MudTh>
                                    <MudTh>عمل ها</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID">@context.Id</MudTd>
                                    <MudTd DataLabel="Name">@context.Name</MudTd>
                                    <MudTd DataLabel="Price">@context.Price</MudTd>
                                    <MudTd DataLabel="Description">@context.Description</MudTd>
                                    <MudTd DataLabel="Special Tag">@context.SpecialTag</MudTd>
                                    <MudTd DataLabel="Image">
                                        @if (!string.IsNullOrEmpty(context.ImageUrl))
                                        {
                                            <img src="@context.ImageUrl" alt="Product Image" style="max-height: 60px; max-width: 60px;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">بدون عکس</span>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudButton Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => HandleRemoveProduct(context.Id))" Class="me-2">
                                            حذف
                                        </MudButton>
                                        <MudButton Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => NavigationManager.NavigateTo($"products/edit/{context.Id}"))">
                                            ویرایش
                                        </MudButton>
                                    </MudTd>
                                </RowTemplate>

                            </MudTable>

                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                                محصولی یافت نشد
                            </MudAlert>
                        }
                    </MudPaper>
                </MudPaper>
           
        }

    </MudContainer>
    </MudPaper>
  

  
@code {
    private bool isLoading { get; set; } = true;
    public IEnumerable<Product> products { get; set; } = new List<Product>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProducts();
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRemoveProduct(int id)
    {
        var product = await prodRepo.Get(id);
        if (product != null)
        {
            await prodRepo.Delete(id);
            await LoadProducts();
            await AlertService.ShowSuccess("موفقت آمیز", "محصول با موفقیت حذف شد!");
        }
    }

    private async Task LoadProducts()
    {
        products = await prodRepo.GetAll();
    }
}
