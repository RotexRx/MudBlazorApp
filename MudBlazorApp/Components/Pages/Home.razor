@page "/"
@inject IProductRepository prodRepo
@inject ICategoryRepository categoryRepository
@inject ICartRepository _cartRepository
@inject AuthenticationStateProvider _AuthenticationStateProvider
@inject NavigationManager navigationManager
@inject SweetAlertService AlertService
@inject IJSRuntime JS

@if (isLoading)
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="height: 70vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Thickness="6" />
        <MudText Typo="Typo.subtitle1" Class="mt-2">در حال بارگذاری...</MudText>
    </div>
}
else
{
    <MudContainer MaxWidth="MaxWidth.False" Class="p-5 mx-0">
        <MudStack Spacing="2" Class="my-3 px-2 p-4" Justify="Justify.Center">

            <MudText Typo="Typo.h6" Color="Color.Primary"> دسته بندی ها</MudText>

            <MudStack Row="true" Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="flex-wrap">

                @foreach (var item in categories)
                {
                    <MudButton Variant="Variant.Filled" Color="@(currentCategory.Name == item.Name ? Color.Primary : Color.Dark)" Disabled="@isLoading" OnClick="@(() => ChangeCategory(item.Name))">
                        @item.Name
                    </MudButton>
                }
            </MudStack>

            <MudDivider />

            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4">لیست محصولات</MudText>

            <MudGrid Class="mt-3" GutterSize="3">
                @foreach (var item in products)
                {
                    @if (item.Category == currentCategory)
                    {


                        <MudItem xs="12" sm="6" md="3">

                            <MudCard>
                                <MudCardMedia Image="@item.ImageUrl" Height="200" />
                                <MudCardContent>
                                    <MudText Typo="Typo.h5"> نام : @($"{item.Name} - ({item.Quantity})") </MudText>
                                    <MudText Typo="Typo.body2">قیمت : @($"{item.Price} $")</MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton DropShadow="true" style="width:100%;" Variant="Variant.Filled" Color="Color.Success">افزودن به سبد خرید</MudButton>
                                </MudCardActions>
                            </MudCard>

                        </MudItem>
                    }
                }
            </MudGrid>
        </MudStack>
    </MudContainer>
}

@code {
    private bool isLoading { get; set; } = true;
    private IEnumerable<Product> products { get; set; } = new List<Product>();
    private IEnumerable<Category> categories { get; set; } = new List<Category>();
    private Category currentCategory { get; set; } = new Category();


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            isLoading = true;
            StateHasChanged();
            await LoadCategories();
            await LoadProducts();

            currentCategory = categories.FirstOrDefault() ?? new Category();

            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCategories()
    {

        categories = await categoryRepository.GetAll();
    }

    private async Task LoadProducts()
    {
        products = await prodRepo.GetAll();
    }

    private async Task ChangeCategory(string categoryName)
    {
        if (string.IsNullOrEmpty(categoryName) || categories == null || !categories.Any())
            return;

        var selectedCategory = categories.FirstOrDefault(c => c.Name.Equals(categoryName, StringComparison.OrdinalIgnoreCase));
        if (selectedCategory != null && selectedCategory != currentCategory)
        {
            isLoading = true;
            StateHasChanged();

            currentCategory = selectedCategory;
            await LoadProducts();

            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PlaceOrder(Product product)
    {
        var authState = await _AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var authenticated = user.Identity != null && user.Identity.IsAuthenticated;

        if (!authenticated)
        {
            navigationManager.NavigateTo("Account/Login");
        }
        else
        {
            await AlertService.ShowSuccess("موفقیت", "سفارش شما ثبت شد!");

            var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
            if (userId != null)
            {
                await _cartRepository.UpdateCartAsync(userId, product.Id, 1);
            }
        }
    }
}
