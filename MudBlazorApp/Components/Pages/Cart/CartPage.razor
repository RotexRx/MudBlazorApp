@page "/cart"
@attribute [Authorize]

@inject AuthenticationStateProvider _AuthenticationStateProvider
@inject IProductRepository _productRepository
@inject ICartRepository _cartRepository
@inject IOrderRepository _orderRepository
@inject NavigationManager navigationManager
@inject SweetAlertService AlertService
@inject IJSRuntime JS

@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using MudBlazorApp.Utility
<MudPaper Class="pa-6 mx-auto mt-5" Style="max-width: 900px;" Elevation="4">
    <MudContainer Class="mt-3" MaxWidth="MaxWidth.Medium">
        @if (isProcessing)
        {
            <div class="d-flex justify-center align-center" style="height:400px">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            </div>
        }
        else if (Carts.Any())
        {




            <MudGrid>
                <MudItem xs="12" lg="6">
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">خلاصه سبد خرید</MudText>

                    @foreach (var item in Carts)
                    {
                        <MudCard>
                            <MudCardMedia Image="@item.Product.ImageUrl" Height="250" />
                            <MudCardContent>
                                <MudText Typo="Typo.h5">@item.Product.Name</MudText>
                                <MudDivider Class="my-3" />
                                <MudText Typo="Typo.body1">قیمت : @item.Product.Price</MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="SpaceBetween" Class="mt-2">
                                    <MudIconButton Variant="Variant.Filled" Icon="@Icons.Material.Filled.Remove" OnClick="@(() => UpdateCartItem(item.ProductId, -1))" />
                                    <MudText Typo="Typo.body1">@item.Count</MudText>
                                    <MudIconButton Variant="Variant.Filled" Icon="@Icons.Material.Filled.Add" OnClick="@(() => UpdateCartItem(item.ProductId, +1))" />
                                </MudStack>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled" Style="width:100%;" Color="Color.Error" OnClick="@(() => UpdateCartItem(item.ProductId, -item.Count))">
                                    حذف
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    }
                </MudItem>

                <MudItem Style="justify-content:space-between;" xs="12" lg="6">
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">جزئیات مرسوله</MudText>

                    <MudPaper Class="p-5" Style="padding:20px;">
                        <EditForm Model="@OrderHeader" OnValidSubmit="HandleFormSubmit">
                            <DataAnnotationsValidator />
                            <MudStack Spacing="2">
                                <MudTextField Label="نام" @bind-Value="OrderHeader.Name" Required="true" />
                                <MudTextField Label="ایمیل" @bind-Value="OrderHeader.Email" Required="true" />
                                <MudTextField Label="تلفن همراه" @bind-Value="OrderHeader.PhoneNumber" Required="true" />

                                <MudDivider Class="my-3" />

                                <MudText Typo="Typo.subtitle1">مجموع قیمت : @OrderHeader.OrderTotal.ToString("C", CultureInfo.GetCultureInfo("en-us"))</MudText>
                                <MudText Typo="Typo.subtitle2">تعداد کالا : @TotalItems</MudText>

                            </MudStack>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success" Class="mt-3 " Style="width:100%;">
                                ثبت سفارش
                            </MudButton>

                        </EditForm>


                       
                    </MudPaper>
                   
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">هیچ محصولی در سبد خرید شما نیست</MudAlert>

        }
    </MudContainer>

</MudPaper>

@code {
    private bool isProcessing { get; set; } = true;
    private IEnumerable<Cart> Carts = new List<Cart>();
    [SupplyParameterFromForm]
    private OrderHeader OrderHeader { get; set; } = new OrderHeader();
    private int TotalItems { get; set; } = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await _AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        OrderHeader.Email = user?.FindFirst(u => u.Type.Contains("email"))?.Value;
        OrderHeader.UserId = user?.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
        OrderHeader.Status = SD.StatusPending;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCart();
            isProcessing = false;
            StateHasChanged();
        }
    }


    private async Task LoadCart()
    {
        Carts = await _cartRepository.GetAllAsync(OrderHeader.UserId);

        OrderHeader.OrderTotal = 0;
        TotalItems = 0;

        foreach (var item in Carts)
        {
            OrderHeader.OrderTotal += (Convert.ToDouble(item.Product.Price) * item.Count);
            TotalItems += item.Count;
        }

        OrderHeader.OrderTotal = Math.Round(OrderHeader.OrderTotal, 2);
    }

    private async Task UpdateCartItem(int productID, int updateBy)
    {
        await _cartRepository.UpdateCartAsync(OrderHeader.UserId, productID, updateBy);
        await LoadCart();
    }

    private async Task HandleFormSubmit()
    {
        isProcessing = true;
        StateHasChanged();

        OrderHeader.OrderDetails = SD.ConvertShopingCartToOrderDetails(Carts.ToList());

        var createdOrder = await _orderRepository.CreateAsync(OrderHeader);
        navigationManager.NavigateTo($"/order/confirmation/{createdOrder.Id}");
    }
}
