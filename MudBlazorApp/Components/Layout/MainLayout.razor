@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="currentTheme"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudRTLProvider RightToLeft=true>
    
<MudLayout >
    <MudAppBar Elevation="1">
    <MudStaticNavDrawerToggle DrawerId="nav-drawer" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.End" />
    <MudText Typo="Typo.h5" Class="mr-3">پروژه دمو</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.Start" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToggleTheme">
    تغییر تم
</MudButton>
</MudAppBar>

<MudDrawer Anchor="Anchor.Right" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Id="nav-drawer">
    <NavMenu />
</MudDrawer>

<MudMainContent>
    @Body
</MudMainContent>

</MudLayout>
</MudRTLProvider>



<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    MudTheme currentTheme;
    private bool _needChangeBodyColor = false;

    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needChangeBodyColor)
        {
            _needChangeBodyColor = false;
            var bgColor = _isDarkMode ? "#32333d" : "#ffffff";
            await JS.InvokeVoidAsync("setBodyBackgroundColor", bgColor);
        }
    }

    private async Task SetBodyBackground(string color)
    {
        await JS.InvokeVoidAsync("setBodyBackgroundColor", color);
    }

    async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        currentTheme = _isDarkMode ? darkTheme : lightTheme;
        _needChangeBodyColor = true;
        StateHasChanged();
    }

    MudTheme lightTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Black = "#272c34",
            Background = "#ffffff",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            AppbarBackground = "#1976d2",
            TextPrimary = "#000000",
            Primary = "#1976d2",
            Secondary = "#9c27b0"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Vazir" }
            }
        }
    };

    MudTheme darkTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Black = "#27272f",
            Background = "#32333d",
            Surface = "#373740",
            DrawerBackground = "#27272f",
            AppbarBackground = "#27272f",
            TextPrimary = "#ffffff",
            Primary = "#90caf9",
            Secondary = "#ce93d8",
            Dark = "#000000",
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Vazir" }
            }
        }
    };
    
      

    

}


